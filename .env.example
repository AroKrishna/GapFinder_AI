# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used only by scripts/seed-demo.ts, never by request handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Google AI Studio → API key (server-only)
GEMINI_API_KEY=your-gemini-key
# Optional overrides
GEMINI_MODEL=gemini-flash-latest
# Comma-separated, tried in order if the primary is overloaded (503), rate-limited or times out.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
